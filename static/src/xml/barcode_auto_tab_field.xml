<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="indoor_inventario.IndoorBarcodeAutoTabField"
       t-inherit="web.CharField"
       t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_field_input_buttons')]" position="inside">
            <button t-if="hasCameraButton"
                    type="button"
                    class="btn btn-link m-0 py-0 px-2 fa fa-camera"
                    tabindex="-1"
                    aria-label="Iniciar modo cámara continuo"
                    title="Iniciar modo cámara continuo"
                    data-tooltip="Iniciar modo cámara continuo"
                    t-on-click="onCameraScan"/>
        </xpath>
    </t>

    <t t-name="indoor_inventario.IndoorCameraQuantityDialog">
        <Dialog title.translate="Registrar lectura" size="'sm'" footer="false">
            <div class="o_indoor_camera_confirmation">
                <div class="text-muted mb-1">Producto</div>
                <h4 class="mb-3" t-esc="props.product.display_name"/>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Código</label>
                        <div class="form-control-plaintext fw-semibold" t-esc="props.barcode"/>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="indoor_camera_quantity">
                            Cantidad<t t-if="props.product.uom_id"> (<t t-esc="props.product.uom_id[1]"/>)</t>
                        </label>
                        <div class="o_indoor_camera_quantity_row">
                            <input id="indoor_camera_quantity"
                                   t-ref="quantity"
                                   t-model.number="state.quantity"
                                   t-on-keydown="onQuantityKeydown"
                                   type="number"
                                   min="0"
                                   step="any"
                                   inputmode="decimal"
                                   class="form-control form-control-lg"/>
                            <button type="button"
                                    class="btn btn-secondary btn-sm o_indoor_camera_action"
                                    t-att-disabled="state.saving"
                                    t-on-click="cancel">
                                Cancelar
                            </button>
                            <button type="button"
                                    class="btn btn-primary btn-sm o_indoor_camera_action"
                                    t-att-disabled="state.saving"
                                    t-on-click="save">
                                <i t-if="state.saving" class="fa fa-spinner fa-spin me-1"/>
                                Guardar
                            </button>
                        </div>
                        <div t-if="state.error" class="text-danger mt-2" t-esc="state.error"/>
                    </div>
                </div>
            </div>
        </Dialog>
    </t>
</templates>
