<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_provisional_product_list" model="ir.ui.view">
        <field name="name">indoor.provisional.product.list</field>
        <field name="model">indoor.provisional.product</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'discarded'" decoration-success="state == 'converted'">
                <field name="name"/>
                <field name="categ_id"/>
                <field name="product_kind"/>
                <field name="route_id"/>
                <field name="sale_ok"/>
                <field name="purchase_ok"/>
                <field name="cost" optional="show"/>
                <field name="source" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="definitive_product_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_provisional_product_form" model="ir.ui.view">
        <field name="name">indoor.provisional.product.form</field>
        <field name="model">indoor.provisional.product</field>
        <field name="arch" type="xml">
            <form string="Producto provisional">
                <header>
                    <button name="action_approve" string="Aprobar" type="object" class="btn-primary"
                            invisible="state not in ('draft', 'quoted')"/>
                    <button name="action_convert" string="Crear o vincular producto" type="object" class="btn-primary"
                            invisible="state in ('converted', 'discarded')"/>
                    <button name="action_discard" string="Descartar" type="object"
                            invisible="state in ('converted', 'discarded')"/>
                    <button name="action_reset_to_draft" string="Volver a borrador" type="object"
                            invisible="state != 'discarded'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,quoted,approved,converted,discarded"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_definitive_product" type="object" class="oe_stat_button"
                                icon="fa-cube" invisible="not definitive_product_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Producto definitivo</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nombre del producto" readonly="state == 'converted'"/></h1>
                    </div>
                    <group>
                        <group string="Definición obligatoria">
                            <field name="categ_id" readonly="state == 'converted'"/>
                            <field name="product_kind" readonly="state == 'converted'"/>
                            <field name="route_id" readonly="state == 'converted'"/>
                            <field name="uom_category_id" invisible="1"/>
                            <field name="uom_id" readonly="state == 'converted'"/>
                            <field name="uom_po_id" readonly="state == 'converted'"/>
                        </group>
                        <group string="Uso y conversión">
                            <field name="sale_ok" readonly="state == 'converted'"/>
                            <field name="purchase_ok" readonly="state == 'converted'"/>
                            <field name="source"/>
                            <field name="cost"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state == 'converted'"/>
                            <field name="definitive_product_id"
                                   readonly="state == 'converted'"
                                   domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"
                                   context="{'active_test': False}"/>
                            <field name="converted_by" invisible="not converted_by"/>
                            <field name="converted_at" invisible="not converted_at"/>
                        </group>
                    </group>
                    <group string="Descripción">
                        <field name="description" nolabel="1" placeholder="Especificaciones para la cotización y el producto definitivo" readonly="state == 'converted'"/>
                    </group>
                    <notebook>
                        <page string="Cotizaciones de venta">
                            <field name="sale_line_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="order_id"/>
                                    <field name="order_partner_id"/>
                                    <field name="product_uom_qty"/>
                                    <field name="price_unit"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Cotizaciones de compra">
                            <field name="purchase_line_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="order_id"/>
                                    <field name="partner_id"/>
                                    <field name="product_qty"/>
                                    <field name="price_unit"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_provisional_product_search" model="ir.ui.view">
        <field name="name">indoor.provisional.product.search</field>
        <field name="model">indoor.provisional.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="categ_id"/>
                <field name="definitive_product_id"/>
                <filter name="pending" string="Pendientes" domain="[('state', 'in', ('draft', 'quoted', 'approved'))]"/>
                <filter name="converted" string="Convertidos" domain="[('state', '=', 'converted')]"/>
                <filter name="discarded" string="Descartados" domain="[('state', '=', 'discarded')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_category" string="Categoría" context="{'group_by': 'categ_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_source" string="Origen" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_provisional_product" model="ir.actions.act_window">
        <field name="name">Productos provisionales</field>
        <field name="res_model">indoor.provisional.product</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_provisional_product_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cree un producto provisional para cotizar</p>
            <p>Se convertirá en producto definitivo únicamente cuando la operación se concrete.</p>
        </field>
    </record>
</odoo>
