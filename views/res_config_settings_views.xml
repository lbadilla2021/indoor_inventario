<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_monthly_standard_cost" model="ir.ui.view">
        <field name="name">res.config.settings.form.monthly.standard.cost</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Costos estándar mensuales" name="monthly_standard_cost_settings">
                    <setting string="Compras consideradas" help="Máximo soportado por la tabla de auditoría: 3.">
                        <field name="indoor_standard_cost_purchase_count"/>
                    </setting>
                    <setting string="Antigüedad de compra">
                        <field name="indoor_standard_cost_stale_days"/><span class="ms-2">días</span>
                    </setting>
                    <setting string="Umbral de advertencia">
                        <field name="indoor_standard_cost_warning_threshold"/><span class="ms-2">%</span>
                    </setting>
                    <setting string="Umbral crítico">
                        <field name="indoor_standard_cost_critical_threshold"/><span class="ms-2">%</span>
                    </setting>
                </block>
                <block title="Control de productos inmovilizados" name="immobilized_product_settings">
                    <setting string="Antigüedad sin consumo"
                             help="Marca como inmovilizados los productos cuyo último consumo en producción supera este plazo.">
                        <field name="indoor_immobilization_months"/><span class="ms-2">meses</span>
                        <div class="mt-3">
                            <button name="action_update_immobilized_products" type="object"
                                    string="Actualizar ahora" class="btn btn-primary"
                                    icon="fa-refresh"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
