<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_provisional_product" model="ir.ui.view">
        <field name="name">sale.order.form.provisional.product</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_template_id']" position="after">
                <field name="is_provisional_placeholder" column_invisible="True"/>
                <field name="provisional_product_id" string="Producto provisional" optional="show"
                       invisible="not is_provisional_placeholder"
                       context="{'default_source': 'sale', 'default_company_id': parent.company_id}"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id'][1]" position="after">
                <field name="is_provisional_placeholder" invisible="1"/>
                <field name="provisional_product_id"
                       invisible="not is_provisional_placeholder"
                       context="{'default_source': 'sale', 'default_company_id': parent.company_id}"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_form_provisional_product" model="ir.ui.view">
        <field name="name">purchase.order.form.provisional.product</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                <field name="is_provisional_placeholder" column_invisible="True"/>
                <field name="provisional_product_id" string="Producto provisional" optional="show"
                       invisible="not is_provisional_placeholder"
                       context="{'default_source': 'purchase', 'default_product_kind': 'goods', 'default_company_id': parent.company_id}"/>
            </xpath>
        </field>
    </record>
</odoo>
