<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inventory_count_session_list" model="ir.ui.view">
        <field name="name">indoor.inventory.count.session.list</field>
        <field name="model">indoor.inventory.count.session</field>
        <field name="arch" type="xml">
            <list string="Sesiones de Inventario">
                <field name="name"/>
                <field name="state" widget="badge"/>
                <field name="location_id"/>
                <field name="responsible_id"/>
                <field name="line_count"/>
                <field name="product_count"/>
                <field name="start_date"/>
                <field name="review_date"/>
                <field name="close_date"/>
            </list>
        </field>
    </record>

    <record id="view_inventory_count_session_search" model="ir.ui.view">
        <field name="name">indoor.inventory.count.session.search</field>
        <field name="model">indoor.inventory.count.session</field>
        <field name="arch" type="xml">
            <search string="Buscar Sesiones de Inventario">
                <field name="name"/>
                <field name="location_id"/>
                <field name="responsible_id"/>
                <filter name="open" string="Abiertas" domain="[('state', 'in', ('draft', 'in_progress'))]"/>
                <filter name="review" string="En revisión" domain="[('state', '=', 'in_review')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_location" string="Ubicación" context="{'group_by': 'location_id'}"/>
                    <filter name="group_responsible" string="Responsable" context="{'group_by': 'responsible_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_inventory_count_session_form" model="ir.ui.view">
        <field name="name">indoor.inventory.count.session.form</field>
        <field name="model">indoor.inventory.count.session</field>
        <field name="arch" type="xml">
            <form string="Sesión de Inventario">
                <header>
                    <button name="action_start" type="object" string="Iniciar" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_send_to_review" type="object" string="Enviar a revisión" class="btn-primary" invisible="state not in ('draft', 'in_progress')"/>
                    <button name="action_prepare_physical_inventory" type="object" string="Preparar inventario físico" class="btn-primary" groups="stock.group_stock_manager" invisible="state != 'in_review'"/>
                    <button name="action_close" type="object" string="Cerrar" class="btn-secondary" groups="stock.group_stock_manager" invisible="state != 'in_review' or not prepared_date"/>
                    <button name="action_cancel" type="object" string="Cancelar" groups="stock.group_stock_manager" invisible="state in ('closed', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,in_review,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="location_id" options="{'no_create_edit': True, 'no_open': True}" readonly="state in ('in_review', 'closed', 'cancelled')"/>
                            <field name="responsible_id" readonly="state in ('closed', 'cancelled')"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="last_scan_date"/>
                            <field name="last_scan_user_id"/>
                            <field name="line_count"/>
                            <field name="product_count"/>
                            <field name="start_date"/>
                            <field name="review_date"/>
                            <field name="prepared_date"/>
                            <field name="prepared_by_id"/>
                            <field name="prepared_quant_count"/>
                            <field name="close_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lecturas">
                            <field name="line_ids" context="{'default_session_id': id, 'default_location_id': location_id}" readonly="state in ('in_review', 'closed', 'cancelled')">
                                <list editable="bottom">
                                    <field name="barcode" widget="indoor_barcode_auto_tab"/>
                                    <field name="product_id" options="{'no_create_edit': True, 'no_open': True}"/>
                                    <field name="quantity"/>
                                    <field name="product_uom_id" readonly="1"/>
                                    <field name="tracking" column_invisible="1"/>
                                    <field name="lot_id" invisible="tracking == 'none'" required="tracking != 'none'" options="{'no_create_edit': True}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas">
                            <field name="note" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_inventory_count_line_list" model="ir.ui.view">
        <field name="name">indoor.inventory.count.line.list</field>
        <field name="model">indoor.inventory.count.line</field>
        <field name="arch" type="xml">
            <list string="Lecturas de Inventario" editable="bottom">
                <field name="scan_date" readonly="1"/>
                <field name="session_id" options="{'no_create_edit': True, 'no_open': True}"/>
                <field name="barcode" widget="indoor_barcode_auto_tab"/>
                <field name="product_id" options="{'no_create_edit': True, 'no_open': True}"/>
                <field name="quantity"/>
                <field name="product_uom_id" readonly="1"/>
                <field name="location_id" options="{'no_create_edit': True, 'no_open': True}"/>
                <field name="tracking" column_invisible="1"/>
                <field name="lot_id" invisible="tracking == 'none'" required="tracking != 'none'" options="{'no_create_edit': True}"/>
                <field name="scan_user_id" readonly="1"/>
                <field name="state" widget="badge" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_inventory_count_line_search" model="ir.ui.view">
        <field name="name">indoor.inventory.count.line.search</field>
        <field name="model">indoor.inventory.count.line</field>
        <field name="arch" type="xml">
            <search string="Buscar Lecturas">
                <field name="barcode"/>
                <field name="product_id"/>
                <field name="session_id"/>
                <field name="location_id"/>
                <field name="scan_user_id"/>
                <filter name="today" string="Hoy" domain="[('scan_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="open" string="Sesiones abiertas" domain="[('state', 'in', ('draft', 'in_progress'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_session" string="Sesión" context="{'group_by': 'session_id'}"/>
                    <filter name="group_product" string="Producto" context="{'group_by': 'product_id'}"/>
                    <filter name="group_location" string="Ubicación" context="{'group_by': 'location_id'}"/>
                    <filter name="group_user" string="Usuario" context="{'group_by': 'scan_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_inventory_count_line_form" model="ir.ui.view">
        <field name="name">indoor.inventory.count.line.form</field>
        <field name="model">indoor.inventory.count.line</field>
        <field name="arch" type="xml">
            <form string="Inventariar" class="o_indoor_mobile_count_form">
                <sheet>
                    <group class="o_indoor_count_header">
                        <field name="session_id" options="{'no_create_edit': True, 'no_open': True}"/>
                        <field name="location_id" options="{'no_create_edit': True, 'no_open': True}"/>
                        <field name="scan_user_id" readonly="1"/>
                        <field name="scan_date" readonly="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="state" widget="badge" readonly="1"/>
                    </group>
                    <group class="o_indoor_scan_panel">
                        <field name="barcode" widget="indoor_barcode_auto_tab" placeholder="Escanee o digite el código" autofocus="autofocus"/>
                        <field name="product_id" options="{'no_create_edit': True, 'no_open': True}"/>
                        <field name="quantity"/>
                        <field name="product_uom_id" readonly="1"/>
                        <field name="tracking" invisible="1"/>
                        <field name="lot_id" invisible="tracking == 'none'" required="tracking != 'none'" options="{'no_create_edit': True}"/>
                    </group>
                    <group>
                        <field name="note" placeholder="Nota opcional"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_inventory_count_consolidated_list" model="ir.ui.view">
        <field name="name">indoor.inventory.count.consolidated.list</field>
        <field name="model">indoor.inventory.count.consolidated</field>
        <field name="arch" type="xml">
            <list string="Sesiones Inventario" create="false" edit="false" delete="false">
                <field name="session_id"/>
                <field name="location_id"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="counted_quantity" sum="Total contado"/>
                <field name="current_quantity"/>
                <field name="difference_quantity" sum="Diferencia total"/>
                <field name="product_uom_id"/>
                <field name="scan_count"/>
                <field name="user_count"/>
                <field name="last_scan_date"/>
            </list>
        </field>
    </record>

    <record id="view_inventory_count_consolidated_search" model="ir.ui.view">
        <field name="name">indoor.inventory.count.consolidated.search</field>
        <field name="model">indoor.inventory.count.consolidated</field>
        <field name="arch" type="xml">
            <search string="Buscar Sesiones Inventario">
                <field name="session_id"/>
                <field name="product_id"/>
                <field name="location_id"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_session" string="Sesión" context="{'group_by': 'session_id'}"/>
                    <filter name="group_location" string="Ubicación" context="{'group_by': 'location_id'}"/>
                    <filter name="group_product" string="Producto" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_inventory_count_line" model="ir.actions.act_window">
        <field name="name">Inventariar</field>
        <field name="res_model">indoor.inventory.count.line</field>
        <field name="view_mode">form,list</field>
        <field name="context">{'search_default_today': 1, 'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Escanee un producto, indique la cantidad contada y guarde la lectura.
            </p>
        </field>
    </record>

    <record id="action_inventory_count_session" model="ir.actions.act_window">
        <field name="name">Sesiones Inventario</field>
        <field name="res_model">indoor.inventory.count.session</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>

    <record id="action_inventory_count_consolidated" model="ir.actions.act_window">
        <field name="name">Sesiones Inventario</field>
        <field name="res_model">indoor.inventory.count.consolidated</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_session': 1}</field>
    </record>

    <function model="indoor.inventory.count.session" name="_migrate_from_ziv_cod_barra"/>
</odoo>
