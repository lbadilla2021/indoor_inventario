<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_standard_cost_analyst" model="res.groups">
        <field name="name">Analista de costos</field>
        <field name="category_id" ref="base.module_category_inventory_inventory"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="group_standard_cost_approver" model="res.groups">
        <field name="name">Aprobador de costos</field>
        <field name="category_id" ref="base.module_category_inventory_inventory"/>
        <field name="implied_ids" eval="[(4, ref('indoor_inventario.group_standard_cost_analyst'))]"/>
    </record>

    <record id="rule_standard_cost_batch_company" model="ir.rule">
        <field name="name">Cierres de costo por compañía</field>
        <field name="model_id" ref="model_indoor_standard_cost_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('indoor_inventario.group_standard_cost_analyst'))]"/>
    </record>
    <record id="rule_standard_cost_line_company" model="ir.rule">
        <field name="name">Líneas de costo por compañía</field>
        <field name="model_id" ref="model_indoor_standard_cost_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('indoor_inventario.group_standard_cost_analyst'))]"/>
    </record>
    <record id="rule_provisional_product_company" model="ir.rule">
        <field name="name">Productos provisionales por compañía</field>
        <field name="model_id" ref="model_indoor_provisional_product"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
